{
  "name": "phi-brain-desktop",
  "private": true,
  "version": "0.1.0",
  "description": "Phi Brain 데스크톱 앱 — 배포된 화면을 여는 창 (설정 설명은 docs/DESKTOP.md 6단계)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "38.1.0",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "design.phi.brain",
    "productName": "Phi Brain",
    "copyright": "Phi Design Institute",
    "directories": { "output": "dist", "buildResources": "assets" },
    "files": ["main.js", "preload.js", "auth.js", "gmail.js", "shell.js", "assets/logo.png", "package.json"],
    "protocols": [{ "name": "Phi Brain", "schemes": ["phibrain"] }],
    "win": {
      "target": ["nsis"],
      "icon": "assets/logo.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Phi Brain",
      "deleteAppDataOnUninstall": false
    }
  }
}

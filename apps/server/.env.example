# Copy this file to .env and fill in real values.

# SQLite for local/personal use. See OPERATIONS.md for the Postgres upgrade
# path when you actually deploy the backend.
DATABASE_URL="file:./prisma/dev.db"

PORT=4000

# "mock" needs no API key and is useful before you have real keys.
# Real options: "anthropic" | "openai"
LLM_PROVIDER=mock
# Optional: falls back to this provider once, only on a rate-limit/quota/5xx
# error from the primary. Leave unset to disable fallback.
LLM_FALLBACK_PROVIDER=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
